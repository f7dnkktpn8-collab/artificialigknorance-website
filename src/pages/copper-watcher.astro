---
import Layout from '../layouts/Layout.astro';
import { PRICING, trialSentence } from '../data/pricing';

const SITE_URL = 'https://artificialigknorance.com';
const APP_STORE_URL = 'https://apps.apple.com/us/app/copper-watcher-cu/id6757655923';
const APP_ICON = '/images/copper-watcher-icon.webp';
const p = PRICING['copper-watcher'];

const faqs = [
    {
        q: 'What is Copper Watcher?',
        a: 'Copper Watcher is the iPhone app for copper investors, scrap dealers, electricians, and metal traders. It tracks the live copper spot price, top copper ETFs (CPER, COPX, COPP) and futures, prediction markets, a smarter sentiment badge, the Dr Copper signal vs the S&P 500, a scrap calculator, and a portfolio with realized profit tracking.'
    },
    {
        q: 'How is the copper spot price tracked?',
        a: 'Spot copper updates throughout the trading day with a live heartbeat indicator. Today\'s Pulse gives a one-sentence read on what\'s moving, and a second line says whether copper is following the S&P, tracking China, or moving on its own. Historical charts cover 1D, 1W, 1M, 3M, 1Y, 5Y, and ALL. Switch between line and dot chart styles, or rotate your iPhone for immersive fullscreen charts.'
    },
    {
        q: 'What is the Dr Copper signal?',
        a: '"Dr. Copper" is the old market nickname for copper\'s ability to predict the broader economy: when copper turns, the S&P 500 often follows. Copper Watcher gives you a live read of that relationship, plotted so you can see when copper is leading or trailing the market.'
    },
    {
        q: 'How does the realized profit work when I sell?',
        a: 'When you sell a position, record the sale price and date: Copper Watcher logs the realized gain and rolls it into a running cumulative profit across all of your closed positions. Gifts can be marked separately so they don\'t inflate the profit number.'
    },
    {
        q: 'What are Prediction Markets?',
        a: 'A live read of Polymarket bets on the forces driving copper (China manufacturing, data-center buildout, industrial production, recession risk), pulled into a section of the Charts tab.'
    },
    {
        q: 'What does the Smarter Sentiment badge do?',
        a: 'A Bullish / Bearish / Neutral indicator that blends short-term price momentum, the health of the 50-day trend, and the tone of recent news headlines into one signal.'
    },
    {
        q: 'How does the scrap calculator work?',
        a: 'Enter the weight and pick the copper grade, from OFHC lab grade (100%) down to #2 copper scrap (95%), and Copper Watcher gives you the value at the current spot price. Built-in labels for every commercial purity level so you can quote a customer instantly.'
    },
    {
        q: 'Can I track my own copper holdings?',
        a: 'Yes. The portfolio tracker manages holdings in oz, g, kg, lb, or tonne. Track purchase price, live P&L per position, and the running realized profit on closed positions. Mark gifts separately so they don\'t inflate the profit number. You can also export your portfolio to a spreadsheet any time and import one back in.'
    },
    {
        q: 'What currencies are supported?',
        a: 'Ten: CAD, USD, EUR, GBP, INR, AUD, CHF, JPY, CNY, and HKD. Pick one and the entire app switches.'
    },
    {
        q: 'What does Premium cost?',
        a: `Free to download. The Portfolio and What-If tabs are unlocked with a Copper Watcher subscription at ${p.monthly} per month or ${p.yearly} per year. ${trialSentence('copper-watcher')} Subscribers can see their plan, price and renewal date in Settings, and switch plans without leaving the app.`
    }
];

const pageStructuredData = {
    '@context': 'https://schema.org',
    '@graph': [
                {
            '@type': 'BreadcrumbList',
            itemListElement: [
                { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
                { '@type': 'ListItem', position: 2, name: 'Copper Watcher', item: SITE_URL + '/copper-watcher/' }
            ]
        },
        {
            '@type': 'FAQPage',
            mainEntity: faqs.map(({ q, a }) => ({
                '@type': 'Question',
                name: q,
                acceptedAnswer: { '@type': 'Answer', text: a }
            }))
        }
    ]
};
---

<Layout
    title="Copper Watcher | Live Copper Spot, Dr Copper Signal, Prediction Markets"
    description="Live copper spot price, ETFs (CPER, COPX, COPP), futures, the Dr Copper signal vs S&P 500, Polymarket prediction markets, sentiment badge, scrap calculator, and portfolio with realized P&L. Free iPhone app for copper investors, scrap dealers, electricians, and traders."
    ogImage={APP_ICON}
    twitterCard="summary_large_image"
    smartAppId="6757655923"
    datePublished="2026-05-08"
    mainEntityId={SITE_URL + "/#copper-watcher"}
>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(pageStructuredData)} />

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="text-sm text-muted pt-6">
        <ol class="flex items-center gap-2">
            <li><a href="/" class="hover:text-ink transition-colors">Home</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-body">Copper Watcher</li>
        </ol>
    </nav>

    <!-- Hero -->
    <section class="relative py-12 sm:py-16">
        <div class="absolute inset-0 opacity-10 pointer-events-none">
            <div class="absolute top-10 left-10 w-32 h-32 bg-amber-400 rounded-full blur-3xl"></div>
            <div class="absolute bottom-10 right-10 w-40 h-40 bg-orange-400 rounded-full blur-3xl"></div>
        </div>

        <div class="relative flex flex-col md:flex-row md:flex-wrap md:justify-center items-center gap-8 md:gap-12">
            <img src={APP_ICON} alt="Copper Watcher app icon" width="180" height="180" class="w-32 h-32 md:w-44 md:h-44 rounded-3xl shadow-2xl flex-shrink-0" />
            <div class="flex-1 max-w-full text-center md:text-left">
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-3 text-ink">
                    Copper Watcher (Cu)
                </h1>
                <p class="text-xl sm:text-2xl text-amber-700 font-medium mb-4">Live copper prices, in your pocket.</p>
                <p class="text-body max-w-2xl mb-6 text-lg">
                    Live copper spot price, ETFs and futures, the Dr Copper signal vs the S&amp;P 500, prediction
                    markets, a smarter sentiment badge, a scrap calculator, and portfolio tracking with realized
                    profit: built for copper investors, scrap dealers, electricians, and metal traders.
                </p>
                <div class="flex flex-wrap gap-3 justify-center md:justify-start">
                    <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="inline-block transition-transform duration-200 hover:scale-105" aria-label="Download on the App Store"><img src="/images/appstore-badge.svg" alt="Download on the App Store" class="h-14 w-auto" loading="lazy" /></a>
                </div>
            </div>
        </div>
    </section>

    <!-- Quick badges -->
    <section class="flex flex-wrap gap-2 justify-center md:justify-start mb-12">
        <span class="px-3 py-1 bg-amber-500/20 text-amber-700 rounded-full text-sm">Home &amp; Lock Screen widgets</span>
        <span class="px-3 py-1 bg-amber-500/20 text-amber-700 rounded-full text-sm">Live spot + Today&apos;s Pulse</span>
        <span class="px-3 py-1 bg-amber-500/20 text-amber-700 rounded-full text-sm">CPER · COPX · COPP</span>
        <span class="px-3 py-1 bg-amber-500/20 text-amber-700 rounded-full text-sm">Dr Copper signal</span>
        <span class="px-3 py-1 bg-amber-500/20 text-amber-700 rounded-full text-sm">Picks &amp; Shovels (CAT, ETN, PWR)</span>
        <span class="px-3 py-1 bg-amber-500/20 text-amber-700 rounded-full text-sm">Scrap calculator</span>
        <span class="px-3 py-1 bg-amber-500/20 text-amber-700 rounded-full text-sm">Signals · news + Polymarket</span>
    </section>

    <!-- What it does -->
    <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8 text-center md:text-left">What it does</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
            <div class="sm:col-span-2 bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <div class="flex items-center gap-2 mb-2">
                    <h3 class="text-xl font-bold text-amber-700">Home &amp; Lock Screen widgets</h3>
                    <span class="px-2 py-0.5 bg-amber-500/20 text-amber-700 rounded-full text-xs font-semibold uppercase tracking-wide">New</span>
                </div>
                <p class="text-body">Add a small or medium widget for the live copper spot price, today&apos;s change, and a 7-day chart, right on your home screen, in your selected currency. Lock Screen widgets show the price and today&apos;s move at a glance. They refresh through the day without opening the app.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-amber-700">Live spot + Today&apos;s Pulse</h3>
                <p class="text-body">Spot copper updated through the trading day with a live heartbeat indicator. Today&apos;s Pulse gives a one-sentence read on what&apos;s moving, and a second line says whether copper is following the S&amp;P, tracking China, or moving on its own. Charts from 1D through 10Y and MAX, line or dot styles, rotate for fullscreen.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-amber-700">Copper ETFs &amp; futures</h3>
                <p class="text-body">Live prices for CPER, COPX, COPP and other top copper ETFs, plus futures contracts. Daily changes and full price history alongside spot.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-amber-700">Dr Copper signal</h3>
                <p class="text-body">A live read on copper&apos;s relationship to the S&amp;P 500, the classic &quot;Dr. Copper&quot; indicator that has predicted recessions and recoveries. Plotted so you can see when copper is leading or trailing the market.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-amber-700">Picks &amp; Shovels</h3>
                <p class="text-body">A Premium section of companies that profit from copper demand: heavy equipment makers like Caterpillar, electrical-component firms (Eaton, nVent), mining service providers, and infrastructure plays. A different angle on copper exposure beyond the metal itself.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-amber-700">Scrap calculator</h3>
                <p class="text-body">Value copper by weight and purity instantly. Built-in grades from OFHC lab grade (100%) down to #2 copper scrap (95%), with labels for every commercial level.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-amber-700">Portfolio with realized P&amp;L</h3>
                <p class="text-body">Holdings in oz, g, kg, lb, or tonne. Live P&amp;L per position, gifts flagged separately, and realized profit logged across every closed position when you record a sale.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-amber-700">Signals</h3>
                <p class="text-body">Live financial news from Reuters, Bloomberg, MarketWatch, Mining.com and more, each with the publisher&apos;s logo. Plus live Polymarket prediction-market odds on the forces driving copper: Fed rate cuts, inflation, China growth, EV demand.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-amber-700">Smarter sentiment</h3>
                <p class="text-body">A Bullish / Bearish / Neutral badge that blends short-term momentum, 50-day trend health, and news-headline tone into one signal.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-amber-700">What-If calculator</h3>
                <p class="text-body">See what a past copper position would be worth today. Compare returns against the S&amp;P 500 and copper ETFs with overlay charts. Toggle between lump-sum and dollar-cost-averaging strategies.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-amber-700">Price alerts</h3>
                <p class="text-body">Set a target price and get a notification when copper crosses it, even with the app closed. Each alert tells you what it hit and how far the price sits from its 52-week high or low.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-amber-700">Light and dark mode</h3>
                <p class="text-body">The app follows your iPhone&apos;s appearance setting and switches the moment you do.</p>
            </div>
        </div>
    </section>

    <!-- See it in action -->
    <section class="mb-16">
        <h2 class="text-3xl font-bold mb-3 text-center md:text-left">See it in action</h2>
        <p class="text-muted mb-8 text-center md:text-left text-sm">Real screens from the App Store. (Sample data shown.)</p>

        <!-- Mobile: horizontal snap-scroll. Desktop: 2-column then 3-column grid. -->
        <div class="flex snap-x snap-mandatory overflow-x-auto gap-4 -mx-6 px-6 pb-4 sm:mx-0 sm:px-0 sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible lg:grid-cols-3">
            <figure class="snap-center flex-shrink-0 w-72 sm:w-auto">
                <picture><source srcset="/images/screenshots/copper-watcher/spot-price.webp" type="image/webp" /><img
                    src="/images/screenshots/copper-watcher/spot-price.jpg"
                    alt="Copper Watcher poster: the live copper price, why it moved, and what you own. The app shows copper at $6.0220 per pound, today's briefing and a one-year price chart"
                    width="800"
                    height="1738"
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-2xl shadow-xl border border-line"
                /></picture>
                <figcaption class="mt-3 text-amber-700 font-semibold text-sm">Live copper price</figcaption>
                <p class="text-xs text-muted mt-1">Spot price, day range, a daily briefing and the full chart.</p>
            </figure>
            <figure class="snap-center flex-shrink-0 w-72 sm:w-auto">
                <picture><source srcset="/images/screenshots/copper-watcher/signals.webp" type="image/webp" /><img
                    src="/images/screenshots/copper-watcher/signals.jpg"
                    alt="Copper Watcher poster titled See what is moving it, showing the Signals screen with Polymarket prediction-market odds on the forces behind copper"
                    width="800"
                    height="1738"
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-2xl shadow-xl border border-line"
                /></picture>
                <figcaption class="mt-3 text-amber-700 font-semibold text-sm">See what is moving it</figcaption>
                <p class="text-xs text-muted mt-1">Live news and prediction-market odds on what moves copper.</p>
            </figure>
            <figure class="snap-center flex-shrink-0 w-72 sm:w-auto">
                <picture><source srcset="/images/screenshots/copper-watcher/alerts.webp" type="image/webp" /><img
                    src="/images/screenshots/copper-watcher/alerts.jpg"
                    alt="Copper Watcher poster titled Get told when it hits your price, showing the Alerts screen with five price targets, each set to go off above or below a level"
                    width="800"
                    height="1738"
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-2xl shadow-xl border border-line"
                /></picture>
                <figcaption class="mt-3 text-amber-700 font-semibold text-sm">Price alerts</figcaption>
                <p class="text-xs text-muted mt-1">Set a target and get a notification, even with the app closed.</p>
            </figure>
            <figure class="snap-center flex-shrink-0 w-72 sm:w-auto">
                <picture><source srcset="/images/screenshots/copper-watcher/portfolio.webp" type="image/webp" /><img
                    src="/images/screenshots/copper-watcher/portfolio.jpg"
                    alt="Copper Watcher poster titled Know what your copper is worth, showing the Portfolio screen with a total value of $811.62, profit of $226.62, a value-over-time chart and a copper bars holding"
                    width="800"
                    height="1738"
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-2xl shadow-xl border border-line"
                /></picture>
                <figcaption class="mt-3 text-amber-700 font-semibold text-sm">Know what it is worth</figcaption>
                <p class="text-xs text-muted mt-1">Every purchase tracked with live profit and loss.</p>
            </figure>
            <figure class="snap-center flex-shrink-0 w-72 sm:w-auto">
                <picture><source srcset="/images/screenshots/copper-watcher/what-if.webp" type="image/webp" /><img
                    src="/images/screenshots/copper-watcher/what-if.jpg"
                    alt="Copper Watcher poster titled What if you had bought sooner?, showing the What If calculator with $10,000 invested 5 years ago and copper ETFs and SPY to compare against"
                    width="800"
                    height="1738"
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-2xl shadow-xl border border-line"
                /></picture>
                <figcaption class="mt-3 text-amber-700 font-semibold text-sm">What if you had bought sooner?</figcaption>
                <p class="text-xs text-muted mt-1">Test any past date and compare it with the S&amp;P 500.</p>
            </figure>
            <figure class="snap-center flex-shrink-0 w-72 sm:w-auto">
                <picture><source srcset="/images/screenshots/copper-watcher/light-dark.webp" type="image/webp" /><img
                    src="/images/screenshots/copper-watcher/light-dark.jpg"
                    alt="Copper Watcher poster titled Light or dark, your call, showing the main screen side by side in dark mode and light mode"
                    width="800"
                    height="1738"
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-2xl shadow-xl border border-line"
                /></picture>
                <figcaption class="mt-3 text-amber-700 font-semibold text-sm">Light or dark</figcaption>
                <p class="text-xs text-muted mt-1">The app follows your iPhone's setting as soon as you change it.</p>
            </figure>
        </div>
    </section>

    <!-- Built for -->
    <section class="mb-16 bg-gradient-to-br from-amber-500/10 to-orange-500/10 backdrop-blur-sm rounded-3xl p-6 md:p-10 border border-amber-400/20">
        <h2 class="text-3xl font-bold mb-6 text-center">Built for copper</h2>
        <p class="text-body text-lg max-w-3xl mx-auto text-center mb-6">
            Most metals apps treat copper as an afterthought. Copper Watcher was built specifically for the people who
            buy, sell, scrap, or stack the red metal, with the calculators and currency support that real traders need.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
            <div class="text-center"><div class="text-amber-700 font-semibold">Investors</div></div>
            <div class="text-center"><div class="text-amber-700 font-semibold">Scrap dealers</div></div>
            <div class="text-center"><div class="text-amber-700 font-semibold">Electricians</div></div>
            <div class="text-center"><div class="text-amber-700 font-semibold">Metal traders</div></div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8 text-center md:text-left">Frequently asked questions</h2>
        <div class="space-y-3">
            {faqs.map(({ q, a }) => (
                <details class="p-5 transition-all bg-white border border-line rounded-2xl group hover:shadow-md">
                    <summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-lg">
                        <span>{q}</span>
                        <svg class="flex-shrink-0 w-8 h-8 p-1.5 transition-transform duration-300 rounded-full bg-[#efeff2] text-muted group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </summary>
                    <p class="mt-3 text-body">{a}</p>
                </details>
            ))}
        </div>
    </section>

    <!-- Other watcher apps: internal links to the rest of the metals lineup -->
    <section class="mb-12 text-center text-sm text-muted">
        <p>
            Also from Artificial Igknorance:
            <a href="/gold-watcher/" class="text-yellow-700 hover:text-yellow-900 underline">Gold Watcher</a> for precious-metals stackers, ·
            <a href="/silver-watcher/" class="text-slate-700 hover:text-slate-900 underline">Silver Watcher</a> for stackers and sterling, ·
            <a href="/lithium-watcher/" class="text-teal-700 hover:text-teal-900 underline">Lithium Watcher</a> for the EV market.
        </p>
    </section>

    <!-- Final CTA -->
    <section class="text-center mb-16 bg-gradient-to-br from-amber-500/15 to-orange-500/15 rounded-3xl p-8 md:p-12 border border-amber-400/20">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">Get Copper Watcher</h2>
        <p class="text-body text-lg mb-8 max-w-2xl mx-auto">Free download on the App Store. Built for iPhone, designed for the copper market.</p>
        <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="inline-block transition-transform duration-200 hover:scale-105" aria-label="Download on the App Store"><img src="/images/appstore-badge.svg" alt="Download on the App Store" class="h-14 w-auto" loading="lazy" /></a>
        <p class="mt-6 text-sm text-muted">Or browse <a href="/" class="text-amber-700 hover:text-amber-900 underline">all Artificial Igknorance apps</a>.</p>
    </section>
</Layout>
