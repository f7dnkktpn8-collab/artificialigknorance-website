---
import Layout from '../layouts/Layout.astro';
import { PRICING, trialSentence } from '../data/pricing';

const SITE_URL = 'https://artificialigknorance.com';
const APP_STORE_URL = 'https://apps.apple.com/us/app/lithium-watcher-li/id6761344726';
const APP_ICON = '/images/lithium-watcher-icon.webp';
const p = PRICING['lithium-watcher'];

const faqs = [
    {
        q: 'What is Lithium Watcher?',
        a: 'Lithium Watcher is the iPhone app for lithium investors and EV-market enthusiasts. It tracks the lithium price via three sources (Lithium Hydroxide CME futures, the GSCI Lithium Index, and the LIT ETF), lithium mining stocks (ALB, SQM, PLL, LAC), the major EV manufacturers (Tesla, Rivian, Lucid, NIO, XPeng, Li Auto, BYD), prediction markets, a smarter sentiment badge, seasonal patterns, and a portfolio with realized profit tracking.'
    },
    {
        q: 'How is the lithium price tracked?',
        a: 'Lithium Watcher pulls three live sources updated throughout the trading day: Lithium Hydroxide CME futures, the GSCI Lithium Index, and the LIT ETF (Global X Lithium & Battery Tech). Today\'s Pulse gives a one-sentence read on what\'s moving, and a second line says whether EV stocks or the lithium miners are driving the day. Historical charts cover 1D, 1W, 1M, 3M, 6M, 1Y, and 5Y, switchable between line and dot styles. Rotate your iPhone for immersive fullscreen charts.'
    },
    {
        q: 'What lithium ETFs and stocks does it cover?',
        a: 'Lithium ETFs include LIT (Global X Lithium & Battery Tech) and KARS (KraneShares Electric Vehicles & Future Mobility). Mining stocks include Albemarle (ALB), Sociedad Química y Minera (SQM), Piedmont Lithium (PLL), and Lithium Americas (LAC).'
    },
    {
        q: 'What is the EV Market tab?',
        a: 'A dedicated tab tracking the major EV manufacturers (Tesla, Rivian, Lucid, NIO, XPeng, Li Auto, BYD) on a single compare chart. Each ticker gets its own fixed colour (no more red/green flipping based on direction) so you can read the chart at a glance.'
    },
    {
        q: 'What is the Lithium vs EV Makers view?',
        a: 'A chart that shows whether lithium is running ahead of or behind the EV boom: the LIT ETF plotted against Tesla, BYD, NIO, Li Auto, XPeng and Rivian over 1, 3 or 5 years. A second view puts the pure-play lithium miners against the sector. Each view explains in plain language what it shows and what it does not.'
    },
    {
        q: 'How does the realized profit work when I sell?',
        a: 'When you sell a position, record the sale price and date: Lithium Watcher logs the realized gain and rolls it into a running cumulative profit across all of your closed positions. Gifts can be marked separately so they don\'t inflate the profit number.'
    },
    {
        q: 'What are Prediction Markets?',
        a: 'A live read of Polymarket bets on the forces driving lithium demand (Tesla quarterly numbers, Rivian deliveries, EV sales targets, battery supply chains), pulled into a section of the Charts tab.'
    },
    {
        q: 'What does the Smarter Sentiment badge do?',
        a: 'A Bullish / Bearish / Neutral indicator that blends short-term price momentum, the health of the 50-day trend, and the tone of recent news headlines into one signal.'
    },
    {
        q: 'What about seasonal patterns?',
        a: 'A 10-year average monthly return chart shows which months lithium has historically been strongest and weakest, useful for timing entries with data instead of guesswork.'
    },
    {
        q: 'What currencies are supported?',
        a: 'USD, CAD, EUR, GBP, AUD, JPY, CHF, CNY, INR, and more. Pick one and the entire app switches.'
    },
    {
        q: 'What does Premium cost?',
        a: `Free to download. The Portfolio tab and the Picks & Shovels section are unlocked with a Lithium Watcher subscription at ${p.monthly} per month or ${p.yearly} per year. ${trialSentence('lithium-watcher')} Subscribers can see their plan, price and renewal date in Settings, and switch plans without leaving the app.`
    }
];

const pageStructuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'BreadcrumbList',
            itemListElement: [
                { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
                { '@type': 'ListItem', position: 2, name: 'Lithium Watcher', item: SITE_URL + '/lithium-watcher/' }
            ]
        },
        {
            '@type': 'FAQPage',
            mainEntity: faqs.map(({ q, a }) => ({
                '@type': 'Question',
                name: q,
                acceptedAnswer: { '@type': 'Answer', text: a }
            }))
        }
    ]
};
---

<Layout
    title="Lithium Watcher | Live Lithium Price, EV Market, Prediction Markets"
    description="Track lithium via three sources (Lithium Hydroxide CME futures, GSCI Lithium Index, LIT ETF), mining stocks (ALB, SQM, PLL, LAC), and EV manufacturers (Tesla, Rivian, NIO, XPeng, BYD) on a single compare chart, plus a Lithium vs EV Makers view. Prediction markets, sentiment, seasonal patterns, and portfolio with realized P&L."
    ogImage={APP_ICON}
    twitterCard="summary_large_image"
    smartAppId="6761344726"
    datePublished="2026-05-08"
    mainEntityId={SITE_URL + "/#lithium-watcher"}
>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(pageStructuredData)} />

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="text-sm text-muted pt-6">
        <ol class="flex items-center gap-2">
            <li><a href="/" class="hover:text-ink transition-colors">Home</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-body">Lithium Watcher</li>
        </ol>
    </nav>

    <!-- Hero -->
    <section class="relative py-12 sm:py-16">
        <div class="absolute inset-0 opacity-10 pointer-events-none">
            <div class="absolute top-10 left-10 w-32 h-32 bg-teal-400 rounded-full blur-3xl"></div>
            <div class="absolute bottom-10 right-10 w-40 h-40 bg-cyan-400 rounded-full blur-3xl"></div>
        </div>

        <div class="relative flex flex-col md:flex-row md:flex-wrap md:justify-center items-center gap-8 md:gap-12">
            <img src={APP_ICON} alt="Lithium Watcher app icon" width="180" height="180" class="w-32 h-32 md:w-44 md:h-44 rounded-3xl shadow-2xl flex-shrink-0" />
            <div class="flex-1 max-w-full text-center md:text-left">
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-3 text-ink">
                    Lithium Watcher (Li)
                </h1>
                <p class="text-xl sm:text-2xl text-teal-700 font-medium mb-4">From lithium mine to the road.</p>
                <p class="text-body max-w-2xl mb-6 text-lg">
                    Lithium prices from three live sources: Lithium Hydroxide CME futures, the GSCI Lithium Index, and
                    the LIT ETF: alongside mining stocks, EV manufacturers, prediction markets, sentiment, and a
                    portfolio with realized profit tracking. Built for the EV-market wave.
                </p>
                <div class="flex flex-wrap gap-3 justify-center md:justify-start">
                    <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="inline-block transition-transform duration-200 hover:scale-105" aria-label="Download on the App Store"><img src="/images/appstore-badge.svg" alt="Download on the App Store" class="h-14 w-auto" loading="lazy" /></a>
                </div>
            </div>
        </div>
    </section>

    <!-- Quick badges -->
    <section class="flex flex-wrap gap-2 justify-center md:justify-start mb-12">
        <span class="px-3 py-1 bg-teal-500/20 text-teal-700 rounded-full text-sm">Home &amp; Lock Screen widgets</span>
        <span class="px-3 py-1 bg-teal-500/20 text-teal-700 rounded-full text-sm">CME · GSCI · LIT</span>
        <span class="px-3 py-1 bg-teal-500/20 text-teal-700 rounded-full text-sm">ALB · SQM · PLL · LAC</span>
        <span class="px-3 py-1 bg-teal-500/20 text-teal-700 rounded-full text-sm">EV Market compare chart</span>
        <span class="px-3 py-1 bg-teal-500/20 text-teal-700 rounded-full text-sm">Lithium vs EV makers</span>
        <span class="px-3 py-1 bg-teal-500/20 text-teal-700 rounded-full text-sm">Picks &amp; Shovels (Premium)</span>
        <span class="px-3 py-1 bg-teal-500/20 text-teal-700 rounded-full text-sm">Signals · news + Polymarket</span>
        <span class="px-3 py-1 bg-teal-500/20 text-teal-700 rounded-full text-sm">Buy/sell signal on LIT</span>
    </section>

    <!-- What it does -->
    <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8 text-center md:text-left">What it does</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
            <div class="sm:col-span-2 bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <div class="flex items-center gap-2 mb-2">
                    <h3 class="text-xl font-bold text-teal-700">Lithium vs EV makers</h3>
                    <span class="px-2 py-0.5 bg-teal-500/20 text-teal-700 rounded-full text-xs font-semibold uppercase tracking-wide">New</span>
                </div>
                <p class="text-body">See whether lithium is running ahead of or behind the EV boom: the LIT ETF charted against Tesla, BYD, NIO, Li Auto, XPeng and Rivian over 1, 3 or 5 years, plus a second view of the pure-play miners against the sector. Each view explains in plain language what it shows and what it does not.</p>
            </div>
            <div class="sm:col-span-2 bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-teal-700">Home &amp; Lock Screen widgets</h3>
                <p class="text-body">Add a small or medium widget for the live LIT ETF price, today&apos;s change, and a 7-day chart, right on your home screen, in your selected currency. Lock Screen widgets show the price and today&apos;s move at a glance. They refresh through the day without opening the app.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-teal-700">Three live lithium prices</h3>
                <p class="text-body">Lithium Hydroxide CME futures, the GSCI Lithium Index, and the LIT ETF, all updated throughout the trading day. Today&apos;s Pulse gives a one-sentence read on what&apos;s moving, and a second line says whether EV stocks or the lithium miners are driving the day. Charts from 1D through 10Y and MAX, line or dot styles, rotate for fullscreen.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-teal-700">Buy/sell signal on LIT</h3>
                <p class="text-body">Where LIT sits in its 3-year price range (Buy Zone, Neutral, or Sell Zone), alongside 50-day and 200-day moving averages and a Trend read. A simple framing for &quot;is lithium expensive or cheap right now?&quot;</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-teal-700">Mining stocks &amp; battery ETFs</h3>
                <p class="text-body">Lithium mining stocks (ALB, SQM, PLL, LAC, SGML) alongside lithium ETFs (LIT, BATT, REMX, DRIV) and the KraneShares EV ETF (KARS), the full battery-and-EV supply chain in one place.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-teal-700">EV Market compare chart</h3>
                <p class="text-body">Tesla, Rivian, Lucid, NIO, XPeng, Li Auto, BYD, GM, Ford, VW and more on a single compare chart. Each ticker gets its own fixed colour, no more red/green flipping based on direction, so the chart reads at a glance.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-teal-700">Picks &amp; Shovels</h3>
                <p class="text-body">A Premium section of companies that profit from lithium demand, heavy equipment makers like Caterpillar, mining service providers, and infrastructure plays. A different angle on lithium exposure beyond the miners themselves.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-teal-700">Portfolio with realized P&amp;L</h3>
                <p class="text-body">Track LIT, ALB, SQM, PLL, LAC and other lithium-sector positions. Live P&amp;L per position, gifts flagged separately, and realized profit logged across every closed position when you record a sale. Export the whole portfolio to a spreadsheet any time, and import one back in.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-teal-700">Signals</h3>
                <p class="text-body">Live financial news from Reuters, Bloomberg, Mining.com and more, each with the publisher&apos;s logo. Plus live Polymarket prediction-market odds on the forces driving lithium demand: Tesla quarterly numbers, Rivian deliveries, EV sales targets, battery supply chains.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-teal-700">Smarter sentiment + seasonal</h3>
                <p class="text-body">A Bullish / Bearish / Neutral badge blending short-term momentum, 50-day trend health, and news-headline tone. Plus a 10-year monthly seasonal-return chart, see which months lithium has historically been strongest.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-teal-700">Price alerts</h3>
                <p class="text-body">Set a target price and get a notification when lithium crosses it, even with the app closed. Each alert tells you what it hit and how far the price sits from its 52-week high or low.</p>
            </div>
            <div class="bg-white rounded-2xl p-6 hover:shadow-md transition-all border border-line">
                <h3 class="text-xl font-bold mb-2 text-teal-700">Light and dark mode</h3>
                <p class="text-body">The app follows your iPhone&apos;s appearance setting and switches the moment you do.</p>
            </div>
        </div>
    </section>

    <!-- See it in action -->
    <section class="mb-16">
        <h2 class="text-3xl font-bold mb-3 text-center md:text-left">See it in action</h2>
        <p class="text-muted mb-8 text-center md:text-left text-sm">Real screens from the App Store. (Sample data shown.)</p>

        <!-- Mobile: horizontal snap-scroll. Desktop: 2-column then 3-column grid. -->
        <div class="flex snap-x snap-mandatory overflow-x-auto gap-4 -mx-6 px-6 pb-4 sm:mx-0 sm:px-0 sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible lg:grid-cols-3">
            <figure class="snap-center flex-shrink-0 w-72 sm:w-auto">
                <picture><source srcset="/images/screenshots/lithium-watcher/markets.webp" type="image/webp" /><img
                    src="/images/screenshots/lithium-watcher/markets.jpg"
                    alt="Lithium Watcher poster: the live lithium price, why it moved, and what you own. The app shows lithium hydroxide at $12.62 per kilogram, the GSCI lithium index, the LIT fund, today's briefing and a buy or sell signal"
                    width="800"
                    height="1738"
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-2xl shadow-xl border border-line"
                /></picture>
                <figcaption class="mt-3 text-teal-700 font-semibold text-sm">Live lithium price</figcaption>
                <p class="text-xs text-muted mt-1">Spot price, day range, a daily briefing and the full chart.</p>
            </figure>
            <figure class="snap-center flex-shrink-0 w-72 sm:w-auto">
                <picture><source srcset="/images/screenshots/lithium-watcher/signals.webp" type="image/webp" /><img
                    src="/images/screenshots/lithium-watcher/signals.jpg"
                    alt="Lithium Watcher poster titled See what is moving it, showing the Signals screen with Polymarket prediction-market odds on the forces behind lithium"
                    width="800"
                    height="1738"
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-2xl shadow-xl border border-line"
                /></picture>
                <figcaption class="mt-3 text-teal-700 font-semibold text-sm">See what is moving it</figcaption>
                <p class="text-xs text-muted mt-1">Live news and prediction-market odds on what moves lithium.</p>
            </figure>
            <figure class="snap-center flex-shrink-0 w-72 sm:w-auto">
                <picture><source srcset="/images/screenshots/lithium-watcher/alerts.webp" type="image/webp" /><img
                    src="/images/screenshots/lithium-watcher/alerts.jpg"
                    alt="Lithium Watcher poster titled Get told when it hits your price, showing the Alerts screen with five price targets, each set to go off above or below a level"
                    width="800"
                    height="1738"
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-2xl shadow-xl border border-line"
                /></picture>
                <figcaption class="mt-3 text-teal-700 font-semibold text-sm">Price alerts</figcaption>
                <p class="text-xs text-muted mt-1">Set a target and get a notification, even with the app closed.</p>
            </figure>
            <figure class="snap-center flex-shrink-0 w-72 sm:w-auto">
                <picture><source srcset="/images/screenshots/lithium-watcher/portfolio.webp" type="image/webp" /><img
                    src="/images/screenshots/lithium-watcher/portfolio.jpg"
                    alt="Lithium Watcher poster titled Know what your holdings are worth, showing the Portfolio screen with a total value of $13,372.60 across LIT, ALB and SQM shares and profit of $1,818.60"
                    width="800"
                    height="1738"
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-2xl shadow-xl border border-line"
                /></picture>
                <figcaption class="mt-3 text-teal-700 font-semibold text-sm">Know what it is worth</figcaption>
                <p class="text-xs text-muted mt-1">Your shares tracked with live profit and loss.</p>
            </figure>
            <figure class="snap-center flex-shrink-0 w-72 sm:w-auto">
                <picture><source srcset="/images/screenshots/lithium-watcher/ev-compare.webp" type="image/webp" /><img
                    src="/images/screenshots/lithium-watcher/ev-compare.jpg"
                    alt="Lithium Watcher poster titled Lithium and the EV makers, showing the EV Market screen comparing lithium with the S&amp;P 500 and Tesla, plus a list of EV maker tickers"
                    width="800"
                    height="1738"
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-2xl shadow-xl border border-line"
                /></picture>
                <figcaption class="mt-3 text-teal-700 font-semibold text-sm">Lithium and the EV makers</figcaption>
                <p class="text-xs text-muted mt-1">See whether lithium is ahead of or behind the EV boom.</p>
            </figure>
            <figure class="snap-center flex-shrink-0 w-72 sm:w-auto">
                <picture><source srcset="/images/screenshots/lithium-watcher/light-dark.webp" type="image/webp" /><img
                    src="/images/screenshots/lithium-watcher/light-dark.jpg"
                    alt="Lithium Watcher poster titled Light or dark, your call, showing the main screen side by side in dark mode and light mode"
                    width="800"
                    height="1738"
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-2xl shadow-xl border border-line"
                /></picture>
                <figcaption class="mt-3 text-teal-700 font-semibold text-sm">Light or dark</figcaption>
                <p class="text-xs text-muted mt-1">The app follows your iPhone's setting as soon as you change it.</p>
            </figure>
        </div>
    </section>

    <!-- Built for -->
    <section class="mb-16 bg-gradient-to-br from-teal-500/10 to-cyan-500/10 backdrop-blur-sm rounded-3xl p-6 md:p-10 border border-teal-400/20">
        <h2 class="text-3xl font-bold mb-6 text-center">Built for the EV revolution</h2>
        <p class="text-body text-lg max-w-3xl mx-auto text-center mb-6">
            Lithium isn't a precious metal. It's an industrial input for the EV economy. Lithium Watcher tracks the
            full supply chain from mine to road, in one app, without bank logins or signups.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
            <div class="text-center"><div class="text-teal-700 font-semibold">Lithium investors</div></div>
            <div class="text-center"><div class="text-teal-700 font-semibold">EV enthusiasts</div></div>
            <div class="text-center"><div class="text-teal-700 font-semibold">Battery sector traders</div></div>
            <div class="text-center"><div class="text-teal-700 font-semibold">Mining-stock followers</div></div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8 text-center md:text-left">Frequently asked questions</h2>
        <div class="space-y-3">
            {faqs.map(({ q, a }) => (
                <details class="p-5 transition-all bg-white border border-line rounded-2xl group hover:shadow-md">
                    <summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-lg">
                        <span>{q}</span>
                        <svg class="flex-shrink-0 w-8 h-8 p-1.5 transition-transform duration-300 rounded-full bg-[#efeff2] text-muted group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </summary>
                    <p class="mt-3 text-body">{a}</p>
                </details>
            ))}
        </div>
    </section>

    <!-- Other watcher apps: internal links to the rest of the metals lineup -->
    <section class="mb-12 text-center text-sm text-muted">
        <p>
            Also from Artificial Igknorance:
            <a href="/gold-watcher/" class="text-yellow-700 hover:text-yellow-900 underline">Gold Watcher</a> for precious-metals stackers, ·
            <a href="/silver-watcher/" class="text-slate-700 hover:text-slate-900 underline">Silver Watcher</a> for stackers and sterling, ·
            <a href="/copper-watcher/" class="text-amber-700 hover:text-amber-900 underline">Copper Watcher</a> for industrial-metals investors.
        </p>
    </section>

    <!-- Final CTA -->
    <section class="text-center mb-16 bg-gradient-to-br from-teal-500/15 to-cyan-500/15 rounded-3xl p-8 md:p-12 border border-teal-400/20">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">Get Lithium Watcher</h2>
        <p class="text-body text-lg mb-8 max-w-2xl mx-auto">Free download on the App Store. Built for iPhone, designed for the lithium and EV markets.</p>
        <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="inline-block transition-transform duration-200 hover:scale-105" aria-label="Download on the App Store"><img src="/images/appstore-badge.svg" alt="Download on the App Store" class="h-14 w-auto" loading="lazy" /></a>
        <p class="mt-6 text-sm text-muted">Or browse <a href="/" class="text-teal-700 hover:text-teal-900 underline">all Artificial Igknorance apps</a>.</p>
    </section>
</Layout>
